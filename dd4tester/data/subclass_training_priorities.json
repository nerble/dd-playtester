      "highest_value_skills": ["nature skills", "bark skin", "wither", "moonray", "sunray"],
      "automation_gaps": ["Nature buffs and area attacks need target-count, friendly-fire, expiry, and recast policies."],
      "source_refs": ["server/src/pre_reqs/pre_req-druid.c", "server/src/magic.c: druid nature spells"]
    },
