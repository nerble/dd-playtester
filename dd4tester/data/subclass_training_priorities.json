    "necromancer": {
      "strategy": "Turn the mage spell engine toward death damage first, then add a corpse servant only after follower control is reliable.",
      "practice_policy": "Raise death magiks to 50% for harm, improve harm, then continue death magiks to 60% for animate dead.",
      "highest_value_skills": ["death magiks", "harm", "animate dead"],
      "automation_gaps": ["Animate dead needs corpse selection, follower ordering, grouping, and replacement policies."],
      "source_refs": ["server/src/pre_reqs/pre_req-necro.c", "server/src/magic.c: spell_harm and spell_animate_dead"]
    },
    "warlock": {
      "strategy": "Add passive weapon attacks to the inherited mage spell rotation, then build reflective protection.",
      "practice_policy": "Raise armed combat knowledge to 40% for second attack; continue major protective magiks only when buff upkeep is available.",
      "highest_value_skills": ["armed combat knowledge", "second attack", "major protective magiks", "dragon shield"],
      "automation_gaps": ["Dragon shield and fireshield need generic pre-hunt casting, expiry, and recast handling."],
      "source_refs": ["server/src/pre_reqs/pre_req-warlock.c", "server/src/fight.c: multi_hit and shield damage", "server/src/magic.c: spell_dragon_shield"]
    },
    "templar": {
      "strategy": "Extend cleric melee throughput with third attack, then add passive recovery and combat buffs.",
